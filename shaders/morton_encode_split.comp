#version 450
#extension GL_GOOGLE_include_directive : require
#extension GL_ARB_gpu_shader_int64 : require

// Body arrays take bindings 0-2 (body_split.glsl); this pipeline's own buffers start at 3.
#include "common.glsl"
#include "body_split.glsl"
#include "octree.glsl"

layout(std430, binding = 3) buffer MortonKeysA { uint64_t morton_keys_a[]; };
layout(std430, binding = 5) buffer SortedIndicesA { int sorted_indices_a[]; };

#define B4(x) (\
    ((uint64_t(x) / 1000L) % 10L) * 8L + \
    ((uint64_t(x) / 100L)  % 10L) * 4L + \
    ((uint64_t(x) / 10L)   % 10L) * 2L + \
    ((uint64_t(x) / 1L)    % 10L) * 1L)

#define B8(x0, x1) \
    (B4(x0) | (B4(x1) << 4))
#define B16(x0, x1, x2, x3) \
    (B8(x0, x1) | (B8(x2, x3) << 8))
#define B32(x0, x1, x2, x3, x4, x5, x6, x7) \
    (B16(x0, x1, x2, x3) | (B16(x4, x5, x6, x7) << 16))
#define B64(x0, x1, x2, x3, x4, x5, x6, x7, x8, x9, x10, x11, x12, x13, x14, x15) \
    (B32(x0, x1, x2, x3, x4, x5, x6, x7) | (B32(x8, x9, x10, x11, x12, x13, x14, x15) << 32))

uint64_t expand_bits_32_3(uint64_t v)
{
    // b9..b0 contiguous -> 8 + 2, the top pair lifted to bit 24
    v = (v | (v << 16)) & B32(1111,1111,0000,0000,0000,0000,1111,1111);

    // -> 4 + 4 + 2, at bits 0, 12 and 24
    v = (v | (v << 8)) & B32(0000,1111,0000,0000,1111,0000,0000,1111);

    // -> five pairs, six bits apart
    v = (v | (v << 4)) & B32(1100,0011,0000,1100,0011,0000,1100,0011);

    // -> ten single bits, three apart: b0 at bit 0 up to b9 at bit 27
    v = (v | (v << 2)) & B32(0100,1001,0010,0100,1001,0010,0100,1001);
    return v;
}

uint64_t expand_bits_64_3(uint64_t v)
{
    v = (v | (v << 32)) & B64(1111,1111,1111,1111,0000,0000,0000,0000,0000,0000,0000,0000,1111,1111,1111,1111);
    v = (v | (v << 16)) & B64(1111,1111,0000,0000,0000,0000,1111,1111,0000,0000,0000,0000,1111,1111,0000,0000);
    v = (v | (v << 8))  & B64(0000,1111,0000,0000,1111,0000,0000,1111,0000,0000,1111,0000,0000,1111,0000,0000);
    v = (v | (v << 4))  & B64(1100,0011,0000,1100,0011,0000,1100,0011,0000,1100,0011,0000,1100,0011,0000,1100);
    v = (v | (v << 2))  & B64(0100,1001,0010,0100,1001,0010,0100,1001,0010,0100,1001,0010,0100,1001,0010,0100);
    return v;
}

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= uint(pc.num_bodies))
        return;

    // Placeholder: writes a trivially valid, deterministic value so the buffer is touched
    // and the pipeline is exercisable end-to-end, but computes no real Morton code yet. The
    // real encode (quantize pos_mass[i].pos into the unit cube, interleave bits) is left for
    // later. Buffer A is always the initial source, before any radix-sort pass has run.
    morton_keys_a[i] = uint64_t(i);
    sorted_indices_a[i] = int(i);
}
