#version 450
#extension GL_GOOGLE_include_directive : require

#include "common.glsl"
#include "body_split.glsl"
#include "octree.glsl"

layout(std430, binding = 7) buffer RadixSortHistogram { uint histogram[]; };

const int RADIX_BUCKETS = 256;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= uint(RADIX_BUCKETS))
        return;

    // Placeholder: passes the histogram through unchanged. Real logic: an exclusive
    // prefix-sum over the buckets (and, for a multi-workgroup histogram, over each
    // workgroup's local counts too), turning per-bucket counts into per-bucket destination
    // offsets for the scatter pass that follows.
    histogram[i] = histogram[i];
}
