#version 450
#extension GL_GOOGLE_include_directive : require
#extension GL_ARB_gpu_shader_int64 : require

#include "common.glsl"
#include "body_split.glsl"
#include "octree.glsl"

layout(std430, binding = 3) buffer MortonKeysA { uint64_t morton_keys_a[]; };
layout(std430, binding = 4) buffer MortonKeysB { uint64_t morton_keys_b[]; };
layout(std430, binding = 7) buffer RadixSortHistogram { uint histogram[]; };

const int RADIX_BITS = 8;
const int RADIX_BUCKETS = 1 << RADIX_BITS;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= uint(pc.num_bodies))
        return;

    // Placeholder: writes a harmless, deterministic value into the histogram rather than a
    // real per-bucket count. Real logic: read the source buffer this pass's parity selects
    // (morton_keys_a if pc.radix_pass is even, morton_keys_b if odd), extract this pass's
    // 8-bit digit from the key (shift by RADIX_BITS * pc.radix_pass), atomicAdd into this
    // workgroup's bucket count.
    if (i < uint(RADIX_BUCKETS))
        histogram[i] = 0;
}
